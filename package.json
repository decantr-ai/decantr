{
  "name": "decantr",
  "private": true,
  "description": "AI Frontend Governance for codebases touched by AI agents",
  "license": "MIT",
  "homepage": "https://decantr.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/decantr-ai/decantr.git"
  },
  "author": "Decantr AI",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build:packages": "pnpm --filter @decantr/essence-spec --filter @decantr/content --filter @decantr/registry --filter @decantr/css --filter @decantr/telemetry run build && pnpm --filter @decantr/core --filter @decantr/verifier --filter @decantr/mcp-server --filter @decantr/cli --filter @decantr/vite-plugin run build",
    "build:apps": "pnpm --filter './apps/api' run build",
    "build": "pnpm run build:packages && pnpm run build:apps",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "pnpm --filter './apps/api' typecheck",
    "biome:check": "biome check packages/",
    "biome:format": "biome format --write packages/",
    "biome:fix": "biome check --write packages/",
    "clean": "pnpm -r exec rm -rf dist",
    "mcp": "node packages/mcp-server/dist/index.js",
    "schemas:sync": "node scripts/sync-schema-copies.mjs",
    "seo:docs-sitemap": "node scripts/generate-docs-sitemap.mjs",
    "seo:indexnow": "node scripts/submit-indexnow.mjs",
    "audit:docs-marketing": "node scripts/audit-docs-marketing.mjs",
    "audit:docs-drift": "node scripts/audit-docs-drift.mjs",
    "audit:public-links": "node scripts/audit-public-links.mjs",
    "audit:package-surface": "node scripts/audit-package-surface.mjs && node scripts/audit-package-permissions.mjs",
    "audit:package-permissions": "node scripts/audit-package-permissions.mjs",
    "audit:packed-content-facade": "node scripts/audit-packed-content-facade.mjs",
    "audit:packed-mcp-server": "node scripts/audit-packed-mcp-server.mjs",
    "audit:3-9-qualification": "node scripts/audit-3-9-qualification-baseline.mjs",
    "audit:3-9-qualification:lint": "node scripts/audit-3-9-qualification-baseline.mjs --lint-only",
    "audit:3-9-release-gate": "node scripts/audit-3-9-release-gate.mjs",
    "qualification:3-9:route": "node scripts/run-3-9-route-qualification.mjs --write-packet",
    "qualification:3-9:machine": "node scripts/run-3-9-machine-qualification.mjs --write-packet",
    "qualification:3-9:human:lint": "node scripts/prepare-3-9-human-review.mjs --lint-only",
    "qualification:3-9:human": "node scripts/prepare-3-9-human-review.mjs --validate",
    "audit:release-readiness": "node scripts/audit-release-readiness.mjs",
    "audit:release-surface": "node scripts/audit-release-surface.mjs",
    "audit:npm-auth": "node scripts/audit-npm-auth.mjs",
    "audit:npm-surface": "node scripts/audit-npm-surface.mjs",
    "npm:trust:plan": "node scripts/configure-npm-trusted-publishing.mjs",
    "npm:trust:configure": "node scripts/configure-npm-trusted-publishing.mjs --write",
    "package-surface:sync": "node scripts/sync-package-support-matrix.mjs && node scripts/sync-security-permissions.mjs",
    "package-permissions:sync": "node scripts/sync-security-permissions.mjs",
    "npm-surface:normalize:dry-run": "node scripts/normalize-npm-dist-tags.mjs",
    "release:plan": "node scripts/release-plan.mjs",
    "release:graduation-plan": "node scripts/graduation-plan.mjs",
    "release:commands": "node scripts/release-commands.mjs",
    "release:preflight": "node scripts/publish-packages.mjs --publish-dry-run",
    "release:verify": "node scripts/verify-published-packages.mjs",
    "release:closeout": "node scripts/audit-release-closeout.mjs",
    "release:closeout:json": "node scripts/audit-release-closeout.mjs --json",
    "release:announce": "node scripts/dispatch-community-release.mjs",
    "release:evidence": "node scripts/generate-release-evidence.mjs",
    "package:retire:dry-run": "node scripts/deprecate-retired-packages.mjs --dry-run",
    "audit:public-api": "node scripts/audit-public-api.mjs",
    "audit:blueprint-governance": "node scripts/audit-blueprint-governance.mjs",
    "audit:content-package": "pnpm --filter @decantr/content validate && pnpm --filter @decantr/content test",
    "audit:blueprint-matrix": "pnpm --filter @decantr/essence-spec --filter @decantr/content --filter @decantr/registry --filter @decantr/core --filter @decantr/cli build && node scripts/audit-blueprint-matrix.mjs",
    "audit:content-contract": "node scripts/audit-content-contract-quality.mjs --all",
    "showcase:build": "node scripts/build-showcases.mjs",
    "showcase:build:shortlist": "SHOWCASE_GOLDEN_ONLY=1 node scripts/build-showcases.mjs",
    "showcase:validate": "node scripts/validate-showcase-manifest.mjs",
    "showcase:audit": "node scripts/audit-showcases.mjs",
    "showcase:shortlist": "node scripts/shortlist-showcases.mjs",
    "showcase:verify:shortlist": "tsx scripts/verify-showcase-shortlist.ts",
    "showcase:dogfood-promote": "node scripts/dogfood-showcase-promotion.mjs",
    "showcase": "pnpm run showcase:build && pnpm run showcase:validate && pnpm run showcase:verify:shortlist",
    "benchmark:proof-field": "node scripts/run-proof-field-report.mjs",
    "benchmark:realworld-corpus": "node scripts/run-realworld-corpus.mjs",
    "benchmark:post-publish-adoption": "node scripts/run-realworld-corpus.mjs --config scripts/realworld-corpus.post-publish.json",
    "benchmark:3-10:validate": "node scripts/benchmark-3-10/validate-program.mjs",
    "benchmark:3-10:lock-corpus": "node scripts/benchmark-3-10/lock-corpus.mjs",
    "benchmark:3-10:day-zero": "node scripts/benchmark-3-10/run-day-zero.mjs",
    "benchmark:3-10:build-candidate": "node scripts/benchmark-3-10/candidate/build.mjs",
    "benchmark:3-10:smoke-context": "node scripts/benchmark-3-10/candidate/smoke-context.mjs",
    "benchmark:3-10:materialize": "node scripts/benchmark-3-10/evaluators/materialize.mjs",
    "benchmark:3-10:qualification-input": "node scripts/benchmark-3-10/evaluators/qualification-input.mjs",
    "benchmark:3-10:qualification-task": "node scripts/benchmark-3-10/evaluators/qualification-task.mjs",
    "benchmark:3-10:container-qualification": "node scripts/benchmark-3-10/evaluators/container-orchestrator.mjs",
    "benchmark:3-10:runtime-matrix": "node scripts/benchmark-3-10/environments/generate-runtime-matrix.mjs",
    "benchmark:3-10:build-runtime-profiles": "node scripts/benchmark-3-10/environments/build-runtime-profiles.mjs",
    "benchmark:3-10:lock-runtime-matrix": "node scripts/benchmark-3-10/environments/lock-runtime-matrix.mjs",
    "benchmark:3-10:privacy-audit": "node scripts/benchmark-3-10/audit/audit-qualification-privacy.mjs --private-input .private/benchmark-3-10/qualification-generator-config.json",
    "benchmark:3-10:test": "node scripts/benchmark-3-10/test.mjs",
    "npm-surface:normalize": "node scripts/normalize-npm-dist-tags.mjs --write"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@types/node": "^25.9.1",
    "entities": "^8.0.0",
    "fflate": "0.8.3",
    "tar": "7.5.20",
    "tsup": "^8.0.0",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  },
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "overrides": {
      "path-to-regexp": "8.4.0",
      "postcss": "8.5.10",
      "ip-address": "10.2.0",
      "qs": "6.15.2",
      "vite": "8.1.0",
      "hono": "4.12.27",
      "@hono/node-server": "2.0.11",
      "fast-uri": "3.1.3",
      "immutable": "5.1.8",
      "undici": "7.28.0",
      "@babel/core": "7.29.6",
      "body-parser": "2.3.0",
      "esbuild": "0.28.1"
    }
  },
  "version": "0.0.1"
}
