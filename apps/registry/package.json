{
  "name": "registry",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "pnpm --filter @decantr/css --filter @decantr/essence-spec --filter @decantr/registry build && node ../../scripts/build-showcases.mjs && node ../../scripts/copy-showcase-dist.mjs && next build",
