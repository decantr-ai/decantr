{
  "version": "4.0.0",
  "dna": {
    "theme": {
      "id": "luminarum",
      "mode": "dark",
      "shape": "pill"
    },
    "spacing": {
      "base_unit": 4,
      "scale": "linear",
      "density": "comfortable",
      "content_gap": "_gap4"
    },
    "typography": {
      "scale": "modular",
      "heading_weight": 600,
      "body_weight": 400
    },
    "color": {
      "palette": "semantic",
      "accent_count": 1,
      "cvd_preference": "auto"
    },
    "radius": {
      "philosophy": "rounded",
      "base": 8
    },
    "elevation": {
      "system": "layered",
      "max_levels": 3
    },
    "motion": {
      "preference": "subtle",
      "duration_scale": 1,
      "reduce_motion": true
    },
    "accessibility": {
      "wcag_level": "AA",
      "focus_visible": true,
      "skip_nav": true
    },
    "constraints": {
      "effects": {
        "doctrine-security-data": "Preserve the existing Supabase auth, admin authorization, billing, API-key, telemetry attribution, privacy, and hosted-registry service boundaries unless a reviewed task explicitly changes them.",
        "doctrine-design-system": "Preserve the registry's Luminarum token bridge, Decantr treatments, shell rhythm, and public/admin/dashboard styling contracts while evolving individual pages."
      }
    },
    "personality": [
      "Vibrant design intelligence registry. Warm coral and amber accents on a rich dark canvas (or crisp warm-white in light mode). Content cards are the hero — outlined with colored type borders, hovering with purpose. Search is instant and faceted. Publishing feels like sharing art. The Decantr dogfood app — built with its own system, proudly showing what the platform produces. Think Figma Community meets shadcn/ui registry."
    ]
  },
  "blueprint": {
    "sections": [
      {
        "id": "registry-browser",
        "role": "public",
        "shell": "top-nav-main",
        "features": [
          "search",
          "pagination"
        ],
        "description": "Public content browsing for a design registry. Search, filter, and explore patterns, themes, blueprints, archetypes, and shells.",
        "pages": [
          {
            "id": "homepage",
            "layout": [
              "blueprint-launch-hero",
              "search-filter-bar",
              "featured-launchpad-list",
              "launchpad-flow",
              "registry-link-list"
            ],
            "route": "/"
          },
          {
            "id": "browse",
            "layout": [
              "search-filter-bar",
              "content-card-grid"
            ],
            "route": "/browse"
          },
          {
            "id": "browse-type",
            "layout": [
              "search-filter-bar",
              "content-card-grid"
            ],
            "route": "/browse/:type"
          },
          {
            "id": "detail",
            "layout": [
              "blueprint-launch-hero",
              "command-rail",
              "blueprint-anatomy",
              "contract-explorer",
              "json-viewer"
            ],
            "route": "/:type/:namespace/:slug"
          },
          {
            "id": "profile",
            "layout": [
              "detail-header",
              "content-card-grid",
              "activity-feed"
            ],
            "route": "/profile/:username"
          },
          {
            "id": "scan",
            "shell_override": "full-bleed",
            "layout": [
              "brownfield-scan"
            ],
            "route": "/scan",
            "directives": [
              "Render as a full-bleed acquisition surface inside the public shell; do not constrain the hero to the registry browser max-width rhythm.",
              "Use Decantr controls, cards, labels, and data-viz treatments before adding route-local CSS.",
              "Keep the scan promise visually clear: no install, no build, no source execution."
            ]
          },
          {
            "id": "privacy",
            "layout": [
              "detail-header",
              "registry-link-list"
            ],
            "route": "/privacy"
          },
          {
            "id": "terms",
            "layout": [
              "detail-header",
              "registry-link-list"
            ],
            "route": "/terms"
          }
        ]
      },
      {
        "id": "user-dashboard",
        "role": "primary",
        "shell": "sidebar-main",
        "features": [
          "auth",
          "api-keys"
        ],
        "description": "Authenticated user area with content management, API key management, account settings, and activity overview.",
        "pages": [
          {
            "id": "overview",
            "layout": [
              "kpi-grid",
              "reputation-badge",
              "activity-feed"
            ],
            "route": "/dashboard"
          },
          {
            "id": "content",
            "layout": [
              "content-card-grid"
            ],
            "route": "/dashboard/content"
          },
          {
            "id": "content-new",
            "layout": [
              "form",
              "json-viewer"
            ],
            "route": "/dashboard/content/new"
          },
          {
            "id": "api-keys",
            "layout": [
              "api-key-row"
            ],
            "route": "/dashboard/api-keys"
          },
          {
            "id": "settings",
            "layout": [
              "account-settings"
            ],
            "route": "/dashboard/settings"
          },
          {
            "id": "billing",
            "layout": [
              "tier-upgrade-card",
              "kpi-grid"
            ],
            "route": "/dashboard/billing"
          },
          {
            "id": "team",
            "layout": [
              "kpi-grid",
              "team-member-row"
            ],
            "route": "/dashboard/team"
          },
          {
            "id": "governance",
            "layout": [
              "kpi-grid",
              "activity-feed",
              "content-card-grid"
            ],
            "route": "/dashboard/governance"
          },
          {
            "id": "private-registry",
            "layout": [
              "search-filter-bar",
              "content-card-grid"
            ],
            "route": "/dashboard/private-registry"
          }
        ]
      },
      {
        "id": "admin-moderation",
        "role": "auxiliary",
        "shell": "sidebar-main",
        "features": [
          "auth",
          "admin"
        ],
        "description": "Admin moderation queue for reviewing, approving, and rejecting community-submitted registry content.",
        "pages": [
          {
            "id": "moderation-queue",
            "layout": [
              "search-filter-bar",
              "moderation-queue-item"
            ],
            "route": "/admin/moderation"
          },
          {
            "id": "commercial-reports",
            "layout": [
              "kpi-grid",
              "activity-feed"
            ],
            "route": "/admin/reports"
          },
          {
            "id": "organizations",
            "layout": [
              "search-filter-bar",
              "content-card-grid",
              "activity-feed"
            ],
            "route": "/admin/organizations"
          },
          {
            "id": "organization-detail",
            "layout": [
              "detail-header",
              "kpi-grid",
              "activity-feed",
              "content-card-grid"
            ],
            "route": "/admin/organizations/:slug"
          },
          {
            "id": "moderation-detail",
            "layout": [
              "content-detail-hero",
              "json-viewer",
              "moderation-queue-item"
            ],
            "route": "/admin/moderation/:id"
          },
          {
            "id": "telemetry",
            "layout": [
              "kpi-grid",
              "search-filter-bar",
              "activity-feed"
            ],
            "route": "/admin/telemetry"
          },
          {
            "id": "telemetry-usage",
            "layout": [
              "kpi-grid",
              "activity-feed",
              "content-card-grid"
            ],
            "route": "/admin/telemetry/usage"
          }
        ]
      },
      {
        "id": "auth-flow",
        "role": "gateway",
        "shell": "centered",
        "features": [
          "auth"
        ],
        "description": "Login, registration, and password recovery with OAuth support",
        "pages": [
          {
            "id": "login",
            "layout": [
              "auth-form"
            ],
            "route": "/login"
          },
          {
            "id": "register",
            "layout": [
              {
                "preset": "register",
                "pattern": "auth-form"
              }
            ],
            "route": "/login?mode=register"
          },
          {
            "id": "forgot-password",
            "layout": [
              {
                "preset": "reset",
                "pattern": "auth-form"
              }
            ],
            "route": "/login?mode=forgot-password"
          }
        ]
      }
    ],
    "features": [
      "search",
      "pagination",
      "auth",
      "api-keys",
      "admin"
    ],
    "routes": {
      "/": {
        "section": "registry-browser",
        "page": "homepage"
      },
      "/login": {
        "section": "auth-flow",
        "page": "login"
      },
      "/login?mode=register": {
        "section": "auth-flow",
        "page": "register"
      },
      "/login?mode=forgot-password": {
        "section": "auth-flow",
        "page": "forgot-password"
      },
      "/browse": {
        "section": "registry-browser",
        "page": "browse"
      },
      "/dashboard": {
        "section": "user-dashboard",
        "page": "overview"
      },
      "/browse/:type": {
        "section": "registry-browser",
        "page": "browse-type"
      },
      "/scan": {
        "section": "registry-browser",
        "page": "scan"
      },
      "/privacy": {
        "section": "registry-browser",
        "page": "privacy"
      },
      "/terms": {
        "section": "registry-browser",
        "page": "terms"
      },
      "/dashboard/team": {
        "section": "user-dashboard",
        "page": "team"
      },
      "/dashboard/governance": {
        "section": "user-dashboard",
        "page": "governance"
      },
      "/dashboard/private-registry": {
        "section": "user-dashboard",
        "page": "private-registry"
      },
      "/admin/moderation": {
        "section": "admin-moderation",
        "page": "moderation-queue"
      },
      "/admin/moderation/:id": {
        "section": "admin-moderation",
        "page": "moderation-detail"
      },
      "/admin/reports": {
        "section": "admin-moderation",
        "page": "commercial-reports"
      },
      "/admin/organizations": {
        "section": "admin-moderation",
        "page": "organizations"
      },
      "/admin/organizations/:slug": {
        "section": "admin-moderation",
        "page": "organization-detail"
      },
      "/admin/telemetry": {
        "section": "admin-moderation",
        "page": "telemetry"
      },
      "/admin/telemetry/usage": {
        "section": "admin-moderation",
        "page": "telemetry-usage"
      },
      "/dashboard/billing": {
        "section": "user-dashboard",
        "page": "billing"
      },
      "/dashboard/content": {
        "section": "user-dashboard",
        "page": "content"
      },
      "/profile/:username": {
        "section": "registry-browser",
        "page": "profile"
      },
      "/dashboard/api-keys": {
        "section": "user-dashboard",
        "page": "api-keys"
      },
      "/dashboard/settings": {
        "section": "user-dashboard",
        "page": "settings"
      },
      "/dashboard/content/new": {
        "section": "user-dashboard",
        "page": "content-new"
      },
      "/:type/:namespace/:slug": {
        "section": "registry-browser",
        "page": "detail"
      }
    }
  },
  "meta": {
    "archetype": "registry-browser",
    "target": "nextjs",
    "platform": {
      "type": "ssr",
      "routing": "pathname"
    },
    "guard": {
      "mode": "strict",
      "dna_enforcement": "error",
      "blueprint_enforcement": "warn"
    },
    "seo": {
      "schema_org": [
        "WebApplication",
        "SoftwareApplication"
      ],
      "meta_priorities": [
        "description",
        "og:image",
        "twitter:card"
      ]
    },
    "navigation": {
      "hotkeys": [
        {
          "key": "g b",
          "label": "Browse Registry",
          "route": "/browse"
        },
        {
          "key": "g d",
          "label": "Dashboard",
          "route": "/dashboard"
        },
        {
          "key": "g s",
          "label": "Settings",
          "route": "/dashboard/settings"
        }
      ],
      "command_palette": true
    }
  }
}
