{
  "name": "decantr-api",
  "version": "3.9.4",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "test": "dotenv -e .env.local -- vitest run",
    "test:watch": "dotenv -e .env.local -- vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@decantr/content": "workspace:*",
    "@decantr/core": "workspace:*",
    "@decantr/essence-spec": "workspace:*",
    "@decantr/verifier": "workspace:*",
    "@hono/node-server": "^2.0.12",
    "ajv": "^8.20.0",
    "hono": "^4.12.32",
    "pino": "^10.3.1"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "ajv-formats": "^3.0.1",
    "dotenv-cli": "^11.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
