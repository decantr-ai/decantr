{
  "name": "@decantr/essence-spec",
  "version": "3.0.0-next.0",
  "description": "Essence schemas, validation, migration, and TypeScript types for Decantr",
  "keywords": [
    "decantr",
    "decantr-ai",
    "essence",
    "json-schema",
    "schema",
    "design-contracts",
    "ai-frontend-governance",
    "design-intelligence",
    "ui-contract"
  ],
  "author": "Decantr AI",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/decantr-ai/decantr/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/decantr-ai/decantr.git",
    "directory": "packages/essence-spec"
  },
  "homepage": "https://decantr.ai",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": {
      "import": "./schema/essence.v4.json"
    },
    "./schema/essence.v4.json": "./schema/essence.v4.json",
    "./schema/essence.v2.json": "./schema/essence.v2.json",
    "./schema/essence.v3.json": "./schema/essence.v3.json"
  },
  "files": [
    "dist",
    "schema"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "node ../../scripts/guard-pnpm-publish.mjs && pnpm build",
    "preversion": "pnpm build && pnpm test"
  },
  "dependencies": {
    "ajv": "^8.20.0"
  }
}
