{
  "name": "@decantr/content",
  "version": "3.9.1",
  "description": "Official Decantr content corpus for AI frontend governance contracts, context, examples, and validation",
  "keywords": [
    "decantr",
    "decantr-ai",
    "ai-frontend-governance",
    "content-corpus",
    "design-contracts",
    "ui-patterns",
    "archetypes",
    "blueprints",
    "themes",
    "content-health"
  ],
  "author": "Decantr AI",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/decantr-ai/decantr/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/decantr-ai/decantr.git",
    "directory": "packages/content"
  },
  "homepage": "https://decantr.ai",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./client": {
      "import": "./dist/client.js",
      "types": "./dist/client.d.ts"
    },
    "./content-types": {
      "import": "./dist/content-types.js",
      "types": "./dist/content-types.d.ts"
    },
    "./schema/*.json": "./schemas/*.json",
    "./schemas/*.json": "./schemas/*.json",
    "./patterns/*.json": "./patterns/*.json",
    "./themes/*.json": "./themes/*.json",
    "./blueprints/*.json": "./blueprints/*.json",
    "./archetypes/*.json": "./archetypes/*.json",
    "./shells/*.json": "./shells/*.json"
  },
  "files": [
    "dist",
    "schemas",
    "patterns",
    "themes",
    "blueprints",
    "archetypes",
    "shells",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "node validate.js",
    "content:health": "node ../cli/dist/bin.js content-health --ci --fail-on error --markdown --output content-health-summary.md",
    "content:health:json": "node ../cli/dist/bin.js content-health --json --output content-health-report.json",
    "content:health:suppressions": "node scripts/audit-content-health-suppressions.js",
    "content:intelligence": "node scripts/audit-content-intelligence.js --report-json=content-intelligence-report.json --summary-markdown=content-intelligence-summary.md",
    "content:certify": "node scripts/certify-registry-v2.js --report-json=content-certification-report.json --summary-markdown=content-certification-summary.md",
    "registry:v2-certify": "pnpm run content:certify",
    "prepublishOnly": "node ../../scripts/guard-pnpm-publish.mjs && pnpm build && pnpm validate"
  },
  "dependencies": {
    "@decantr/essence-spec": "workspace:*",
    "ajv": "^8.20.0"
  }
}
