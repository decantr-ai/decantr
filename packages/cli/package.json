{
  "name": "@decantr/cli",
  "version": "3.5.5",
  "description": "Decantr CLI - adopt, verify, graph, and govern frontend codebases touched by AI agents",
  "keywords": [
    "decantr",
    "decantr-ai",
    "ai-coding",
    "ai-frontend-governance",
    "cli",
    "project-health",
    "typed-graph",
    "contract-capsule",
    "design-governance",
    "ui-verification",
    "drift-detection",
    "scaffolding",
    "brownfield",
    "cursor",
    "claude-code",
    "windsurf"
  ],
  "author": "Decantr AI",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/decantr-ai/decantr/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/decantr-ai/decantr.git",
    "directory": "packages/cli"
  },
  "homepage": "https://decantr.ai",
  "type": "module",
  "bin": {
    "decantr": "dist/bin.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "src/templates",
    "src/bundled"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "certify:blueprints": "pnpm build && node scripts/certify-blueprints.mjs",
    "certify:workflows": "pnpm build && node scripts/certify-workflows.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "node ../../scripts/guard-pnpm-publish.mjs && pnpm build",
    "preversion": "pnpm build && pnpm test"
  },
  "dependencies": {
    "@decantr/core": "workspace:*",
    "@decantr/essence-spec": "workspace:*",
    "@decantr/registry": "workspace:*",
    "@decantr/telemetry": "workspace:*",
    "@decantr/verifier": "workspace:*",
    "ajv": "^8.20.0"
  }
}
