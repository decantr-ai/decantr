{
  "name": "@decantr/css",
  "version": "3.8.1",
  "description": "Legacy optional CSS atom runtime for explicit Decantr adapter adoption",
  "author": "Decantr AI",
  "bugs": {
    "url": "https://github.com/decantr-ai/decantr/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/decantr-ai/decantr.git",
    "directory": "packages/css"
  },
  "homepage": "https://decantr.ai",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "prepublishOnly": "node ../../scripts/guard-pnpm-publish.mjs && pnpm build",
    "preversion": "pnpm build && pnpm test"
  },
  "keywords": [
    "decantr",
    "decantr-ai",
    "css",
    "atoms",
    "utility-css",
    "legacy-adapter",
    "design-tokens",
    "ai-frontend-governance"
  ],
  "license": "MIT",
  "devDependencies": {
    "jsdom": "^30.0.0",
    "tsup": "^8.0.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
