{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://decantr.ai/schemas/benchmark-3-10/day-zero-target-oracle.schema.json",
  "title": "Decantr 3.10 Day-0 Target Oracle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "program",
    "corpus",
    "sourceReport",
    "review",
    "repositories"
  ],
  "properties": {
    "schemaVersion": {
      "const": "decantr-day-zero-target-oracle.v1"
    },
    "program": {
      "const": "decantr-3.10-ui-change-control-proof"
    },
    "corpus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "sha256", "repositoryCount", "repositoryIds"],
      "properties": {
        "schemaVersion": {
          "const": "decantr-benchmark-corpus.v1"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "repositoryCount": {
          "type": "integer",
          "minimum": 1
        },
        "repositoryIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/slug"
          }
        }
      }
    },
    "sourceReport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "sha256"],
      "properties": {
        "schemaVersion": {
          "const": "decantr-day-zero-report.v1"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "review": {
      "$ref": "#/$defs/topLevelReview"
    },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/repository"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "nullableString": {
      "type": ["string", "null"]
    },
    "stringArray": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      }
    },
    "topLevelReview": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "approvedBy", "approvedAt", "method", "notes"],
          "properties": {
            "status": {
              "const": "draft"
            },
            "approvedBy": {
              "type": "null"
            },
            "approvedAt": {
              "type": "null"
            },
            "method": {
              "type": "null"
            },
            "notes": {
              "$ref": "#/$defs/stringArray"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "approvedBy", "approvedAt", "method", "notes"],
          "properties": {
            "status": {
              "const": "approved"
            },
            "approvedBy": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "approvedAt": {
              "type": "string",
              "format": "date-time"
            },
            "method": {
              "type": "string",
              "minLength": 20
            },
            "notes": {
              "$ref": "#/$defs/stringArray"
            }
          }
        }
      ]
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "observedAtDraft", "expectations", "review"],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "observedAtDraft": {
          "$ref": "#/$defs/observed"
        },
        "expectations": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/expectations"
            }
          ]
        },
        "review": {
          "$ref": "#/$defs/repositoryReview"
        }
      }
    },
    "observed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "applicability",
        "projectMode",
        "routeStrategy",
        "routeAuthority",
        "routeCompleteness",
        "taskableTargets",
        "components",
        "stylingApproach",
        "stylingConfidence",
        "limitations"
      ],
      "properties": {
        "status": {
          "enum": ["completed", "harness_failure", "scan_failure"]
        },
        "applicability": {
          "$ref": "#/$defs/nullableString"
        },
        "projectMode": {
          "$ref": "#/$defs/nullableString"
        },
        "routeStrategy": {
          "$ref": "#/$defs/nullableString"
        },
        "routeAuthority": {
          "$ref": "#/$defs/nullableString"
        },
        "routeCompleteness": {
          "$ref": "#/$defs/nullableString"
        },
        "taskableTargets": {
          "type": "integer",
          "minimum": 0
        },
        "components": {
          "type": "integer",
          "minimum": 0
        },
        "stylingApproach": {
          "$ref": "#/$defs/nullableString"
        },
        "stylingConfidence": {
          "$ref": "#/$defs/nullableString"
        },
        "limitations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/limitationSnapshot"
          }
        }
      }
    },
    "limitationSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "text"],
      "properties": {
        "source": {
          "enum": ["discovery", "styling"]
        },
        "text": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "repositoryReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence", "notes"],
      "properties": {
        "status": {
          "enum": ["pending", "approved"]
        },
        "evidence": {
          "$ref": "#/$defs/stringArray"
        },
        "notes": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "expectations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectMode",
        "routeAuthority",
        "minimums",
        "stylingAuthority",
        "knownLimitations"
      ],
      "properties": {
        "projectMode": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "routeAuthority": {
          "type": "object",
          "additionalProperties": false,
          "required": ["family", "acceptedStrategies", "minimumLevel", "minimumCompleteness"],
          "properties": {
            "family": {
              "$ref": "#/$defs/slug"
            },
            "acceptedStrategies": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/nonEmptyString"
              }
            },
            "minimumLevel": {
              "enum": ["unknown", "unresolved", "inferred", "proven"]
            },
            "minimumCompleteness": {
              "enum": ["unknown", "partial", "complete"]
            }
          }
        },
        "minimums": {
          "type": "object",
          "additionalProperties": false,
          "required": ["taskableTargets", "components"],
          "properties": {
            "taskableTargets": {
              "type": "integer",
              "minimum": 0
            },
            "components": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "stylingAuthority": {
          "type": "object",
          "additionalProperties": false,
          "required": ["family", "acceptedApproaches", "minimumConfidence"],
          "properties": {
            "family": {
              "$ref": "#/$defs/slug"
            },
            "acceptedApproaches": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/nonEmptyString"
              }
            },
            "minimumConfidence": {
              "enum": ["unknown", "low", "medium", "high"]
            }
          }
        },
        "knownLimitations": {
          "type": "object",
          "additionalProperties": false,
          "required": ["allowUnexpected", "required", "allowed"],
          "properties": {
            "allowUnexpected": {
              "type": "boolean"
            },
            "required": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/limitationMatcher"
              }
            },
            "allowed": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/limitationMatcher"
              }
            }
          }
        }
      }
    },
    "limitationMatcher": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source", "match", "text"],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "source": {
          "enum": ["discovery", "styling", "either"]
        },
        "match": {
          "enum": ["exact", "contains"]
        },
        "text": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    }
  }
}
