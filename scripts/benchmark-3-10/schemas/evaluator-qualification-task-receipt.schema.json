{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://decantr.ai/schemas/benchmark-3-10/evaluator-qualification-task-receipt.v2.json",
  "title": "Decantr 3.10 evaluator qualification task receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "program",
    "taskId",
    "partition",
    "qualified",
    "qualifiedAt",
    "executionAssurance",
    "candidateSetSha256",
    "candidateSha256",
    "corpusSha256",
    "prequalificationBundleFileSha256",
    "prequalificationBundleSha256",
    "evaluatorSpecSha256",
    "oracleSourceSha256",
    "evaluatorContractSha256",
    "qualificationControllerSha256",
    "environmentSpecSha256",
    "environmentSubstanceSha256",
    "runtimeMatrixFileSha256",
    "runtimeMatrixSha256",
    "runtimeProfileId",
    "benchmarkImageDigest",
    "networkMode",
    "execution",
    "baseResultSha256",
    "baseResultFileSha256",
    "expectedResultSha256",
    "expectedResultFileSha256",
    "receiptSha256"
  ],
  "properties": {
    "schemaVersion": { "const": "decantr-benchmark-evaluator-qualification-task-receipt.v2" },
    "program": { "const": "decantr-3.10-ui-change-control-proof" },
    "taskId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,95}$" },
    "partition": { "enum": ["development", "qualification"] },
    "qualified": { "const": true },
    "qualifiedAt": { "type": "string", "format": "date-time" },
    "executionAssurance": { "const": "github-host-container-attested" },
    "candidateSetSha256": { "$ref": "#/$defs/sha256" },
    "candidateSha256": { "$ref": "#/$defs/sha256" },
    "corpusSha256": { "$ref": "#/$defs/sha256" },
    "prequalificationBundleFileSha256": { "$ref": "#/$defs/sha256" },
    "prequalificationBundleSha256": { "$ref": "#/$defs/sha256" },
    "evaluatorSpecSha256": { "$ref": "#/$defs/sha256" },
    "oracleSourceSha256": { "$ref": "#/$defs/sha256" },
    "evaluatorContractSha256": { "$ref": "#/$defs/sha256" },
    "qualificationControllerSha256": { "$ref": "#/$defs/sha256" },
    "environmentSpecSha256": { "$ref": "#/$defs/sha256" },
    "environmentSubstanceSha256": { "$ref": "#/$defs/sha256" },
    "runtimeMatrixFileSha256": { "$ref": "#/$defs/sha256" },
    "runtimeMatrixSha256": { "$ref": "#/$defs/sha256" },
    "runtimeProfileId": { "type": "string", "minLength": 1 },
    "benchmarkImageDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "networkMode": { "const": "none" },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attestationFileSha256",
        "attestationSha256",
        "controllerSha256",
        "evaluatorSourceClosureSha256",
        "inputRequestFileSha256",
        "inputRequestSha256",
        "inputManifestFileSha256",
        "inputManifestSha256",
        "runnerRepositoryCommit",
        "provenanceBundleFileSha256",
        "provenanceVerificationSha256",
        "repository",
        "signerWorkflow",
        "sourceRef",
        "predicateType",
        "denySelfHostedRunners"
      ],
      "properties": {
        "attestationFileSha256": { "$ref": "#/$defs/sha256" },
        "attestationSha256": { "$ref": "#/$defs/sha256" },
        "controllerSha256": { "$ref": "#/$defs/sha256" },
        "evaluatorSourceClosureSha256": { "$ref": "#/$defs/sha256" },
        "inputRequestFileSha256": { "$ref": "#/$defs/sha256" },
        "inputRequestSha256": { "$ref": "#/$defs/sha256" },
        "inputManifestFileSha256": { "$ref": "#/$defs/sha256" },
        "inputManifestSha256": { "$ref": "#/$defs/sha256" },
        "runnerRepositoryCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "provenanceBundleFileSha256": { "$ref": "#/$defs/sha256" },
        "provenanceVerificationSha256": { "$ref": "#/$defs/sha256" },
        "repository": { "const": "decantr-ai/decantr" },
        "signerWorkflow": {
          "const": "decantr-ai/decantr/.github/workflows/benchmark-3-10-evaluator-qualification.yml"
        },
        "sourceRef": { "type": "string", "minLength": 1 },
        "predicateType": { "const": "https://slsa.dev/provenance/v1" },
        "denySelfHostedRunners": { "const": true }
      }
    },
    "baseResultSha256": { "$ref": "#/$defs/sha256" },
    "baseResultFileSha256": { "$ref": "#/$defs/sha256" },
    "expectedResultSha256": { "$ref": "#/$defs/sha256" },
    "expectedResultFileSha256": { "$ref": "#/$defs/sha256" },
    "receiptSha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
