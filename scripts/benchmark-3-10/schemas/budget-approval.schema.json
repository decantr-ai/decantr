{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://decantr.ai/schemas/benchmark-3-10/budget-approval.v1.json",
  "title": "Decantr 3.10 explicit paid benchmark approval",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "approvalId",
    "program",
    "approvedBy",
    "approvedAt",
    "expiresAt",
    "maximumSpendUsd",
    "runPlanSha256",
    "candidateTarballSetSha256",
    "modelIds",
    "authorizationStatement"
  ],
  "properties": {
    "schemaVersion": { "const": "decantr-benchmark-budget-approval.v1" },
    "approvalId": { "type": "string", "pattern": "^approval-[a-zA-Z0-9._-]+$" },
    "program": { "const": "decantr-3.10-ui-change-control-proof" },
    "approvedBy": { "type": "string", "minLength": 3 },
    "approvedAt": { "type": "string", "format": "date-time" },
    "expiresAt": { "type": "string", "format": "date-time" },
    "maximumSpendUsd": { "type": "number", "exclusiveMinimum": 0, "maximum": 4160 },
    "runPlanSha256": { "$ref": "#/$defs/sha256" },
    "candidateTarballSetSha256": { "$ref": "#/$defs/sha256" },
    "modelIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "powerPilotSha256": { "$ref": "#/$defs/sha256" },
    "authorizationStatement": {
      "const": "I approve paid Decantr 3.10 benchmark model execution up to the stated limit."
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
