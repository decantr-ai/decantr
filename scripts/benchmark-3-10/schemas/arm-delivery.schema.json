{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://decantr.ai/schemas/benchmark-3-10/arm-delivery.v1.json",
  "title": "Decantr 3.10 operational arm delivery",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "arm",
    "sharedTaskInputSha256",
    "sharedTaskInput",
    "instructions",
    "productContext"
  ],
  "properties": {
    "schemaVersion": { "const": "decantr-benchmark-arm-delivery.v1" },
    "arm": { "enum": ["control", "treatment"] },
    "sharedTaskInputSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sharedTaskInput": { "type": "object" },
    "instructions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 10 }
    },
    "productContext": { "type": ["object", "null"] }
  },
  "allOf": [
    {
      "if": { "properties": { "arm": { "const": "control" } } },
      "then": { "properties": { "productContext": { "type": "null" } } }
    },
    {
      "if": { "properties": { "arm": { "const": "treatment" } } },
      "then": { "properties": { "productContext": { "type": "object" } } }
    }
  ]
}
