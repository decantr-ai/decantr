{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://decantr.ai/schemas/benchmark-3-10/evaluator-contract.v2.json",
  "title": "Decantr 3.10 candidate-independent evaluator contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "contractId", "taskId", "oracle", "commands"],
  "properties": {
    "schemaVersion": { "const": "decantr-benchmark-evaluator-contract.v2" },
    "contractId": { "type": "string", "minLength": 3 },
    "taskId": { "type": "string", "minLength": 3 },
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidateIndependent", "decantrOutputAllowed", "sourceSha256"],
      "properties": {
        "candidateIndependent": { "const": true },
        "decantrOutputAllowed": { "const": false },
        "sourceSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/command" }
    }
  },
  "$defs": {
    "command": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "runtime", "executable", "args", "cwd", "timeoutMs", "required", "resultFormat"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$" },
          "kind": { "enum": ["build", "functional", "governance", "accessibility", "visual"] },
          "runtime": { "enum": ["controller", "task"] },
          "executable": { "type": "string", "minLength": 1 },
          "args": { "type": "array", "items": { "type": "string" } },
          "cwd": { "type": "string", "minLength": 1 },
          "timeoutMs": { "type": "integer", "minimum": 100, "maximum": 7200000 },
          "required": { "type": "boolean" },
          "resultFormat": { "enum": ["exit-code", "json-stdout"] },
          "environment": {
            "type": "object",
            "additionalProperties": { "type": "string" },
            "propertyNames": { "pattern": "^[A-Z_][A-Z0-9_]*$" }
          }
        }
      }
  }
}
