{
  "version": "4.0.0",
  "dna": {
    "theme": { "id": "proof-lab", "mode": "light", "shape": "rounded" },
    "spacing": { "base_unit": 4, "scale": "linear", "density": "comfortable", "content_gap": "_gap4" },
    "typography": { "scale": "modular", "heading_weight": 650, "body_weight": 400 },
    "color": { "palette": "semantic", "accent_count": 1, "cvd_preference": "auto" },
    "radius": { "philosophy": "rounded", "base": 8 },
    "elevation": { "system": "layered", "max_levels": 3 },
    "motion": { "preference": "subtle", "duration_scale": 1, "reduce_motion": true },
    "accessibility": { "wcag_level": "AA", "focus_visible": true, "skip_nav": true },
    "personality": ["clear", "analytical", "calm"]
  },
  "blueprint": {
    "sections": [
      {
        "id": "insights",
        "role": "primary",
        "shell": "top-nav-main",
        "features": ["search", "records"],
        "description": "Runtime evidence fixture with searchable records.",
        "pages": [
          {
            "id": "home",
            "route": "/",
            "layout": ["hero-summary", "record-search"]
          }
        ]
      }
    ],
    "features": ["search", "records"],
    "routes": {
      "/": { "section": "insights", "page": "home" }
    }
  },
  "meta": {
    "archetype": "insights",
    "target": "react-vite",
    "platform": { "type": "spa", "routing": "history" },
    "guard": { "mode": "guided", "dna_enforcement": "error", "blueprint_enforcement": "warn" }
  }
}
